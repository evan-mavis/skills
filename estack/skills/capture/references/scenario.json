{
  "origin": "https://your-authorized-development-host.example",
  "session": "choose-a-unique-run-session",
  "width": 1600,
  "height": 1000,
  "fps": 60,
  "steps": [
    {"action": "assert_text", "selector": "h1", "text": "Observed heading", "label": "Verify starting state"},
    {"action": "click", "selector": "button[data-testid='observed-read-only-control']", "label": "Open observed details"},
    {"action": "assert_text", "selector": "main", "text": "Observed result", "label": "Verify visible result"},
    {"action": "still", "label": "Preserve raw result screenshot"},
    {"action": "scroll", "y": 600, "milliseconds": 850, "label": "Read more details"},
    {"action": "wait", "seconds": 0.6, "label": "Read the result"}
  ]
}
